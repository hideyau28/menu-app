# Postgres (Neon pooled URL for Vercel; direct URL OK for local / migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# TLS for node-pg (Neon: require)
DATABASE_SSL=require

# Keep pool tiny on Vercel serverless
DB_POOL_MAX=1

# Public site URL (OG / metadataBase)
NEXT_PUBLIC_SITE_URL=https://menu-app.vercel.app
